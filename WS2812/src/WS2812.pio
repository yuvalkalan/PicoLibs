.program ws2812
.side_set 1

; WS2812 has a period of 1.25us (800kHz).
; We configure the state machine to run at 8MHz (1 cycle = 0.125us).
; T1 + T2 + T3 = 10 cycles = 1.25us.

.define public T1 2 ; 0.25us
.define public T2 5 ; 0.625us
.define public T3 3 ; 0.375us

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1] ; Side-set to 0, delay T3. Pull next bit.
    jmp !x do_zero side 1 [T1 - 1] ; Side-set to 1. If bit is 0, jump after T1.
do_one:
    jmp  bitloop   side 1 [T2 - 1] ; Keep 1 for T2 (long pulse), then loop.
do_zero:
    nop            side 0 [T2 - 1] ; Drop to 0 for T2 (short pulse), then loop.
.wrap