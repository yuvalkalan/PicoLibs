.program dshot600
.side_set 1

; DShot600 operates at 600kHz. 
; PIO clock is set to 12MHz (20 cycles per bit).

.wrap_target
    pull block     side 0       ; Block until DMA feeds a new word
    set y, 15      side 0       ; 16 bits per DShot frame

bitloop:
    out x, 1       side 1 [5]   ; (1-6) High for 6 cycles. T0/T1 start.
    jmp !x do_0    side 1       ; (7) High for 1 more cycle. If 0, jump.
do_1:
    jmp end        side 1 [7]   ; (8-15) High for 8 cycles (T1H = 15 total)
do_0:
    nop            side 0 [7]   ; (8-15) Low for 8 cycles (T0H = 7 total)
end:
    jmp y-- bitloop side 0 [4]  ; (16-20) Low for 5 cycles. Decrement and loop.
    
    ; Inter-frame gap required by ESCs
    ; 32 iterations * 16 cycles = 512 cycles = ~42.6 µs gap
    set y, 31      side 0
gaploop:
    jmp y-- gaploop side 0 [15]
.wrap